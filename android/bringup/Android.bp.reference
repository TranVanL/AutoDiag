// Reference Android.bp for the native VDiag HAL service.
// Place this file at hardware/interfaces/vdiag/aidl/default/Android.bp
// inside the AOSP source tree.


cc_binary {
    name: "android.hardware.vdiag@1.0-service",
    relative_install_path: "hw",
    init_rc: ["android.hardware.vdiag@1.0-service.rc"],
    vendor: true,

    srcs: [
        "main.cpp",
        "DiagnosticHal.cpp",
    ],

    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "liblog",
        "libutils",
        "android.hardware.vdiag-V1-ndk",
    ],

    cflags: [
        "-Wall",
        "-Werror",
    ],
}
